rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Library sync validation
    function isValidLibrarySync(data) {
      return data.keys().hasAll(['readChapters', 'customCollections']) &&
        data.keys().hasOnly(['readChapters', 'customCollections', 'totalSecondsSpent', 'lastReadDate', 'updatedAt']) &&
        data.readChapters is list && data.readChapters.size() <= 5000 &&
        data.customCollections is list && data.customCollections.size() <= 100 &&
        (!('totalSecondsSpent' in data) || (data.totalSecondsSpent is number && data.totalSecondsSpent >= 0)) &&
        (!('lastReadDate' in data) || (data.lastReadDate is string && data.lastReadDate.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Favorite manga validation
    function isValidFavorite(data) {
      return data.keys().hasAll(['mangaId', 'title', 'userCategory']) &&
        data.keys().hasOnly(['mangaId', 'title', 'coverUrl', 'sourceName', 'sourceId', 'userCategory', 'userScore', 'userNotes', 'customCollections', 'updatedAt']) &&
        data.mangaId is string && data.mangaId.size() > 0 && data.mangaId.size() <= 256 &&
        data.title is string && data.title.size() <= 512 &&
        (data.userCategory in ['reading', 'completed', 'plan_to_read', 'on_hold', 'dropped']) &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048)) &&
        (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 64)) &&
        (!('sourceId' in data) || (data.sourceId is string && data.sourceId.size() <= 64)) &&
        (!('userScore' in data) || (data.userScore is number && data.userScore >= 0 && data.userScore <= 10)) &&
        (!('userNotes' in data) || (data.userNotes is string && data.userNotes.size() <= 2048)) &&
        (!('customCollections' in data) || (data.customCollections is list && data.customCollections.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // History item validation
    function isValidHistoryItem(data) {
      return data.keys().hasAll(['mangaId', 'chapterId', 'pageNumber']) &&
        data.keys().hasOnly(['mangaId', 'mangaTitle', 'mangaCover', 'chapterId', 'chapterNumber', 'chapterTitle', 'pageNumber', 'totalPages', 'scrollRatio', 'sourceId', 'updatedAt']) &&
        data.mangaId is string && data.mangaId.size() > 0 && data.mangaId.size() <= 256 &&
        data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() <= 256 &&
        data.pageNumber is number && data.pageNumber >= 0 &&
        (!('mangaTitle' in data) || (data.mangaTitle is string && data.mangaTitle.size() <= 512)) &&
        (!('mangaCover' in data) || (data.mangaCover is string && data.mangaCover.size() <= 2048)) &&
        (!('chapterNumber' in data) || (data.chapterNumber is string && data.chapterNumber.size() <= 64)) &&
        (!('chapterTitle' in data) || (data.chapterTitle is string && data.chapterTitle.size() <= 256)) &&
        (!('totalPages' in data) || (data.totalPages is number && data.totalPages >= 0)) &&
        (!('scrollRatio' in data) || (data.scrollRatio is number && data.scrollRatio >= 0.0 && data.scrollRatio <= 1.0)) &&
        (!('sourceId' in data) || (data.sourceId is string && data.sourceId.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Match rules for user documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection for library sync state
      match /library/{syncDocId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(syncDocId) && isValidLibrarySync(incoming());
        allow delete: if isOwner(userId) && isValidId(syncDocId);
      }

      // Subcollection for favorites
      match /favorites/{favId} {
        allow get: if isOwner(userId) && isValidId(favId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(favId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId) && isValidId(favId);
      }

      // Subcollection for history / reading progress
      match /history/{histId} {
        allow get: if isOwner(userId) && isValidId(histId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(histId) && isValidHistoryItem(incoming());
        allow delete: if isOwner(userId) && isValidId(histId);
      }
    }
  }
}
